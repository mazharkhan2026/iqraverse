generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  disabled
}

enum RoleName {
  student
  instructor
  admin
}

model User {
  practiceAttempts          Attempt[]
  attemptRequests           IdempotencyRecord[]
  ownedQuestions            Question[]          @relation("QuestionOwner")
  reviewedQuestionSources   Source[]            @relation("QuestionSourceReviewer")
  questionModerationReviews ModerationReview[]  @relation("QuestionReviewer")
  questionImportBatches     ImportBatch[]       @relation("QuestionImportCreator")
  id                        String              @id @default(uuid()) @db.Uuid
  email                     String              @unique
  passwordHash              String              @map("password_hash")
  status                    UserStatus          @default(active)
  emailVerifiedAt           DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile      Profile?
  roles        UserRole[] @relation("AssignedRoles")
  grantedRoles UserRole[] @relation("GrantedRoles")
  revokedRoles UserRole[] @relation("RevokedRoles")

  sessionFamilies    AuthSessionFamily[]
  verificationTokens VerificationToken[]
  resetTokens        ResetToken[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("profiles")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  name RoleName @unique

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedBy String?   @map("granted_by") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy String?   @map("revoked_by") @db.Uuid

  user User @relation("AssignedRoles", fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  grantor User? @relation("GrantedRoles", fields: [grantedBy], references: [id], onDelete: Restrict)
  revoker User? @relation("RevokedRoles", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId, revokedAt])
  @@map("user_roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model AuthSessionFamily {
  attempts  Attempt[]
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions RefreshSession[]

  @@index([userId, revokedAt])
  @@map("auth_session_families")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  parentId  String?   @unique @map("parent_id") @db.Uuid

  family AuthSessionFamily @relation(fields: [familyId], references: [id], onDelete: Restrict)

  parent      RefreshSession? @relation("TokenRotation", fields: [parentId], references: [id], onDelete: Restrict)
  replacement RefreshSession? @relation("TokenRotation")

  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("verification_tokens")
}

model ResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("reset_tokens")
}

enum SyllabusStatus {
  draft
  published
  archived
}

model Exam {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants ExamVariant[]

  @@map("exams")
}

model ExamVariant {
  assessments Assessment[]
  attempts    Attempt[]
  id          String       @id @default(uuid()) @db.Uuid
  examId      String       @map("exam_id") @db.Uuid
  code        String
  name        String
  isActive    Boolean      @default(false) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)

  syllabusVersions SyllabusVersion[]

  @@unique([examId, code])
  @@map("exam_variants")
}

model SyllabusVersion {
  assessments       Assessment[]
  attempts          Attempt[]
  id                String         @id @default(uuid()) @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  edition           String
  applicabilityYear Int?           @map("applicability_year")
  sourceUri         String?        @map("source_uri")
  sourceLabel       String         @map("source_label")
  status            SyllabusStatus @default(draft)
  publishedAt       DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ExamVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  subjects Subject[]

  @@unique([variantId, edition])
  @@index([variantId, status])
  @@map("syllabus_versions")
}

model Subject {
  id                String   @id @default(uuid()) @db.Uuid
  syllabusVersionId String   @map("syllabus_version_id") @db.Uuid
  code              String
  name              String
  weightage         Decimal? @db.Decimal(5, 2)
  sortOrder         Int      @default(0) @map("sort_order")

  syllabusVersion SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Restrict)

  chapters Chapter[]

  @@unique([syllabusVersionId, code])
  @@index([syllabusVersionId, sortOrder])
  @@map("subjects")
}

model Chapter {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  code      String
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  topics Topic[]

  @@unique([subjectId, code])
  @@index([subjectId, sortOrder])
  @@map("chapters")
}

model Topic {
  attemptItems          AttemptItem[]
  questions             Question[]
  questionImportRecords ImportStagingRecord[]
  id                    String                @id @default(uuid()) @db.Uuid
  chapterId             String                @map("chapter_id") @db.Uuid
  code                  String
  name                  String
  sortOrder             Int                   @default(0) @map("sort_order")

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@unique([chapterId, code])
  @@index([chapterId, sortOrder])
  @@map("topics")
}

// Question bank and restricted import staging — v3.3

enum SourceRightsStatus {
  pending
  authorized
  denied
  revoked
}

enum QuestionScope {
  platform
  course
}

enum QuestionFormat {
  single_select
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

enum QuestionReviewStatus {
  draft
  pending
  approved
  rejected
}

enum QuestionReviewDecision {
  approve
  reject
  request_changes
}

enum ImportBatchStatus {
  pending
  processing
  completed
  failed
}

enum ImportParserOutcome {
  valid
  malformed
  duplicate
}

enum ImportReviewStatus {
  pending
  quarantined
  rejected
  approved
}

model Source {
  id             String             @id @default(uuid()) @db.Uuid
  code           String
  version        Int                @default(1)
  title          String
  sourceUri      String?            @map("source_uri")
  checksum       String?
  rightsStatus   SourceRightsStatus @default(pending) @map("rights_status")
  rightsEvidence String?            @map("rights_evidence")
  reviewedById   String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  reviewer         User?             @relation("QuestionSourceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  passages         Passage[]
  questionVersions QuestionVersion[]
  importBatches    ImportBatch[]

  @@unique([code, version])
  @@index([rightsStatus])
  @@map("sources")
}

model Passage {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  title     String?
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  source           Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  questionVersions QuestionVersion[]

  @@index([sourceId])
  @@map("passages")
}

model Question {
  assessmentItems AssessmentItem[]
  attemptItems    AttemptItem[]
  id              String           @id @default(uuid()) @db.Uuid
  topicId         String           @map("topic_id") @db.Uuid
  ownerId         String?          @map("owner_id") @db.Uuid
  scope           QuestionScope    @default(platform)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  topic    Topic             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  owner    User?             @relation("QuestionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  versions QuestionVersion[]

  @@index([topicId, scope])
  @@index([ownerId])
  @@map("questions")
}

model QuestionVersion {
  assessmentItems AssessmentItem[]
  attemptItems    AttemptItem[]
  id              String               @id @default(uuid()) @db.Uuid
  questionId      String               @map("question_id") @db.Uuid
  version         Int
  sourceId        String               @map("source_id") @db.Uuid
  sourceRecordId  String?              @map("source_record_id")
  sourcePage      Int?                 @map("source_page")
  passageId       String?              @map("passage_id") @db.Uuid
  format          QuestionFormat       @default(single_select)
  difficulty      QuestionDifficulty
  prompt          String
  optionsJson     Json                 @map("options_json")
  answerKeyJson   Json                 @map("answer_key_json")
  explanation     String
  marks           Decimal              @default(1) @db.Decimal(8, 2)
  fingerprint     String?
  status          QuestionReviewStatus @default(draft)
  isCurrent       Boolean              @default(false) @map("is_current")
  shuffleOptions  Boolean              @default(false) @map("shuffle_options")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  question       Question              @relation(fields: [questionId], references: [id], onDelete: Restrict)
  source         Source                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  passage        Passage?              @relation(fields: [passageId], references: [id], onDelete: Restrict)
  reviews        ModerationReview[]
  stagingRecords ImportStagingRecord[]

  @@unique([questionId, version])
  @@index([status, isCurrent, difficulty])
  @@index([sourceId, sourceRecordId])
  @@index([fingerprint])
  @@index([passageId])
  @@map("question_versions")
}

model ModerationReview {
  id                String                 @id @default(uuid()) @db.Uuid
  questionVersionId String                 @map("question_version_id") @db.Uuid
  reviewerId        String                 @map("reviewer_id") @db.Uuid
  decision          QuestionReviewDecision
  notes             String?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  reviewer        User            @relation("QuestionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([questionVersionId, createdAt])
  @@index([reviewerId])
  @@map("moderation_reviews")
}

model ImportBatch {
  id            String            @id @default(uuid()) @db.Uuid
  sourceId      String            @map("source_id") @db.Uuid
  createdById   String            @map("created_by_id") @db.Uuid
  inputChecksum String            @map("input_checksum")
  parserVersion String            @map("parser_version")
  status        ImportBatchStatus @default(pending)
  expectedCount Int?              @map("expected_count")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(3)

  source    Source                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdBy User                  @relation("QuestionImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  records   ImportStagingRecord[]

  @@unique([sourceId, inputChecksum, parserVersion])
  @@index([status])
  @@map("import_batches")
}

model ImportStagingRecord {
  id                String              @id @default(uuid()) @db.Uuid
  batchId           String              @map("batch_id") @db.Uuid
  sourceRecordId    String              @map("source_record_id")
  sourcePage        Int?                @map("source_page")
  sourceSection     String?             @map("source_section")
  sourceQuestionNo  String?             @map("source_question_no")
  parserOutcome     ImportParserOutcome @map("parser_outcome")
  reviewStatus      ImportReviewStatus  @default(quarantined) @map("review_status")
  payload           Json?
  issues            Json?
  fingerprint       String?
  topicId           String?             @map("topic_id") @db.Uuid
  difficulty        QuestionDifficulty?
  questionVersionId String?             @map("question_version_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  batch           ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  topic           Topic?           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion? @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@unique([batchId, sourceRecordId])
  @@index([batchId, parserOutcome, reviewStatus])
  @@index([topicId, difficulty])
  @@index([fingerprint])
  @@index([questionVersionId])
  @@map("import_staging_records")
}

// Practice persistence — proposed v3.3; mock blueprint/event models follow.
enum AttemptMode {
  practice
  mock
  course
}

enum AttemptStatus {
  active
  submitted
  expired
}

enum AttemptCompletionReason {
  user_submit
  deadline
  violation_limit
}

model Assessment {
  id                String           @id @default(uuid()) @db.Uuid
  variantId         String           @map("variant_id") @db.Uuid
  syllabusVersionId String           @map("syllabus_version_id") @db.Uuid
  mode              AttemptMode
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  variant           ExamVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  syllabus          SyllabusVersion  @relation(fields: [syllabusVersionId], references: [id], onDelete: Restrict)
  items             AssessmentItem[]
  attempts          Attempt[]

  @@index([variantId, syllabusVersionId, mode])
  @@map("assessments")
}

model AssessmentItem {
  id                String          @id @default(uuid()) @db.Uuid
  assessmentId      String          @map("assessment_id") @db.Uuid
  questionId        String          @map("question_id") @db.Uuid
  questionVersionId String          @map("question_version_id") @db.Uuid
  position          Int
  assessment        Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, position])
  @@unique([assessmentId, questionId])
  @@map("assessment_items")
}

model Attempt {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  assessmentId       String                   @map("assessment_id") @db.Uuid
  variantId          String                   @map("variant_id") @db.Uuid
  syllabusVersionId  String                   @map("syllabus_version_id") @db.Uuid
  sessionFamilyId    String                   @map("session_family_id") @db.Uuid
  mode               AttemptMode
  status             AttemptStatus            @default(active)
  startedAt          DateTime                 @default(now()) @map("started_at") @db.Timestamptz(3)
  deadlineAt         DateTime?                @map("deadline_at") @db.Timestamptz(3)
  submittedAt        DateTime?                @map("submitted_at") @db.Timestamptz(3)
  completionReason   AttemptCompletionReason? @map("completion_reason")
  availableMarks     Decimal                  @map("available_marks") @db.Decimal(8, 2)
  earnedMarks        Decimal?                 @map("earned_marks") @db.Decimal(8, 2)
  resultSnapshot     Json?                    @map("result_snapshot")
  integrityPolicy    Json                     @map("integrity_policy")
  countedViolations  Int                      @default(0) @map("counted_violations")
  flagged            Boolean                  @default(false)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assessment         Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  variant            ExamVariant              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  syllabus           SyllabusVersion          @relation(fields: [syllabusVersionId], references: [id], onDelete: Restrict)
  sessionFamily      AuthSessionFamily        @relation(fields: [sessionFamilyId], references: [id], onDelete: Restrict)
  items              AttemptItem[]
  idempotencyRecords IdempotencyRecord[]

  @@index([userId, variantId, syllabusVersionId, mode, startedAt])
  @@index([userId, mode, status])
  @@index([status, deadlineAt])
  @@map("attempts")
}

model AttemptItem {
  id                String          @id @default(uuid()) @db.Uuid
  attemptId         String          @map("attempt_id") @db.Uuid
  questionId        String          @map("question_id") @db.Uuid
  questionVersionId String          @map("question_version_id") @db.Uuid
  topicId           String          @map("topic_id") @db.Uuid
  position          Int
  presentation      Json
  correctOptionId   String          @map("correct_option_id")
  explanation       String
  marks             Decimal         @db.Decimal(8, 2)
  attempt           Attempt         @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  topic             Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  answer            AttemptAnswer?

  @@unique([attemptId, position])
  @@unique([attemptId, questionId])
  @@index([topicId, questionId])
  @@map("attempt_items")
}

model AttemptAnswer {
  itemId      String      @id @map("item_id") @db.Uuid
  answer      String
  isCorrect   Boolean?    @map("is_correct")
  earnedMarks Decimal?    @map("earned_marks") @db.Decimal(8, 2)
  savedAt     DateTime    @default(now()) @map("saved_at") @db.Timestamptz(3)
  item        AttemptItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("attempt_answers")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  operation   String
  key         String
  requestHash String   @map("request_hash")
  attemptId   String   @map("attempt_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
  @@map("idempotency_records")
}
